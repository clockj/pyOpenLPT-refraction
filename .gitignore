#ignore
/x64/
/out/
/build/
/build-clangd/
/.metadata/
/.cache/
/.settings/
/.vscode/
/.vs/
*.o
/OpenLPT/
/bin/
/test/inputs/test_STB/*.mat
/test/inputs/test_PIVChallenge/
/test/results/*
pyOpenLPT.egg-info/
pyOpenLPT/*
git-filter-repo
build/
build-py/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyd
*.so
*.dylib
*.sln
*.vcxproj
*.filters

# ignore all __pycache__ directories
/**/__pycache__/

# Auto-generated update scripts
update_openlpt.bat
update_openlpt.command

# Temporary repair scripts
repair_environment.bat

# Local OpenCode config
opencode.jsonc

# OpenCode directory
.opencode/
.opencode
opencode.json

tmp/

build-tests

test/
!/test/
!/test/inputs/
!/test/inputs/test_STB/
/test/inputs/test_STB/generated*/
!/test/inputs/test_STB/regenerate_test_stb.py
!/test/inputs/test_STB/evaluate_tracking_metrics.py
!/test/inputs/test_STB/run_pr_tracking_regression.py

# ignore everything
.sisyphus/*

# but keep plans folder
!.sisyphus/plans/
!.sisyphus/plans/**

scripts/
artifacts/

# tests/ is scratch by default, but the curved-port validation suite is part of
# the source. Written as tests/** rather than tests/ so the negations below can
# re-include: git cannot re-include a file whose parent directory is excluded.
tests/**
!tests/test_refract_oracles.py
!tests/test_refract_curved_cpp.py
!tests/test_refract_curved_camera.py
!tests/test_refract_calibration.py
!tests/test_refract_curved_audit.py
# wand calibration through a cylindrical port: the pytest subset, and the test campaign (plan, scripts,
# results, report) under tests/cylinder_wand/
!tests/test_cylinder_wand.py
!tests/cylinder_wand/
!tests/cylinder_wand/**
tests/cylinder_wand/**/__pycache__/
# wand calibration through flat windows: the pytest subset, and the test campaign under tests/plate_wand/ (the W6
# case folders hold regenerable data and the GUI's working files: w6_vs_gui.py prepare/run rebuilds them)
!tests/test_plate_wand.py
!tests/plate_wand/
!tests/plate_wand/**
tests/plate_wand/**/__pycache__/
tests/plate_wand/w6_cases/
# STB speed and robustness improvements: the pytest subset, and the test campaign under tests/stb_improve/
# (runs/ and data/ hold benchmark runs and copied images, regenerable with the campaign's scripts)
!tests/test_stb_improve.py
!tests/stb_improve/
!tests/stb_improve/**
tests/stb_improve/**/__pycache__/
tests/stb_improve/runs/
tests/stb_improve/data/
# the wand calibrations in the GUI (cylinder port, flat windows, the results page): tests/cylinder_wand_gui/
# (data/ holds rendered images and run outputs, regenerable with its scripts)
!tests/cylinder_wand_gui/
!tests/cylinder_wand_gui/**
tests/cylinder_wand_gui/**/__pycache__/
tests/cylinder_wand_gui/data/
# the campaign's build trees and the saved baseline build
build-stb/
build-py-baseline/

test/inputs/test_LPTNetBenchmark
docs/

Paper/

.opencode-agenthub
